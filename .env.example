# ADSMS Environment Configuration

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_CONSUMER_GROUP=adsms

# Service Ports
TELEMETRY_PORT=3001
STATE_MANAGER_PORT=3002
MISSION_SERVICE_PORT=3003
COMMAND_DISPATCH_PORT=3004
SWARM_INTELLIGENCE_PORT=3005
COLLISION_AVOIDANCE_PORT=3006
VIDEO_SERVICE_PORT=3007
GEOFENCE_SERVICE_PORT=3008
ALERT_SERVICE_PORT=3009
SAFETY_MANAGER_PORT=3010
ANALYTICS_SERVICE_PORT=3011
DRONE_REGISTRY_PORT=3012
AUTH_SERVICE_PORT=3013
INTEGRATION_SERVICE_PORT=3014
NOTIFICATION_SERVICE_PORT=3015

# Databases
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=adsms_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=adsms

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

TIMESCALEDB_HOST=timescaledb
TIMESCALEDB_PORT=5432
TIMESCALEDB_USER=adsms_user
TIMESCALEDB_PASSWORD=changeme
TIMESCALEDB_DB=adsms_timescale

# MinIO
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=24h

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Features
ENABLE_SIMULATION=false
ENABLE_DEBUG=false
